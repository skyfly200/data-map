# ── Local development ─────────────────────────────────────────────────────────
# The frontend talks to the local Express API via Vite's proxy (/api → :3001),
# so no config is needed for a basic local run. Just: npm install && npm run dev

# Override the API base URL if you run the server on a different host/port:
# VITE_API_URL=http://localhost:3001/api

# Server port (default 3001):
# PORT=3001

# SQLite database file path (default server/data.sqlite):
# DB_PATH=./server/data.sqlite

# Optional: Google Earth Engine service account JSON (enables NDVI enrichment)
# GEE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ── Future: Supabase + Netlify deploy path (not needed for local) ─────────────
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
