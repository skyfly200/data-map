# Frontend (VITE_ prefix required — safe to expose, anon key only)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Netlify Functions only — never expose to frontend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auto-set by Netlify in production. Set manually for local netlify dev:
URL=http://localhost:8888

# Optional: Google Earth Engine service account JSON (enables NDVI enrichment)
GEE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
