# Copy to .env and adjust. The pipeline (CLI and notebook) reads these; real
# secrets never belong in git, so .env itself is gitignored.

# ─── What to fetch ────────────────────────────────────────────────────────────
# Comma-separated iNaturalist taxa. Genus names work well; common names
# (e.g. "cantharellus" rather than "chanterelle") match more reliably.
SPECIES=auricularia, tremella, xylaria, cordyceps, ganoderma, tricholoma, hydnellum, hydnum, clavariadelphus, pleurotus, hericium, morchella, amanita, boletus, sarcodon, russula, lactarius, cortinarius, clitocybe, hypholoma, hygrophorus, psilocybe, coprinus, coprinopsis, marasmius, mycena, lepiota, agaricus, flammulina, boletopsis, albatrellus, fomitopsis, trametes, trichaptum, lanmaoa, hypomyces, cantharellus, grifola, laetiporus, armillaria, rhizopogon

# ─── Where to fetch ───────────────────────────────────────────────────────────
# Multiple regions in one run: INAT_LOCATIONS is a semicolon-separated list of
# "lat,lng,radius_km". Every species is fetched around every location.
INAT_LOCATIONS=45.108,-121.762,100; 40.0,-105.0,500

# Single-region alternative (used only when INAT_LOCATIONS is unset):
# INAT_LOCATION=45.108,-121.762
# INAT_RADIUS=100

# Plus codes: fetch each code's rectangular cell as a bounding box (not a
# radius). The code's length sets the area — use a SHORTER (zero-padded) full
# code for a LARGER box:
#   84QW4600+  ~0.05°  (~5.5 km)     8 digits
#   84QW0000+  ~1°     (~111 km)     4 digits + "0000" padding
#   85000000+  ~20°    (~2200 km)    2 digits + "000000" padding
# Drop trailing *pairs* only — odd padding (e.g. 84Q00000+) is not a valid full
# code and is skipped. Semicolon-separated; combined with any INAT_LOCATIONS
# above. Radius does not apply and any extra field is ignored.
# INAT_PLUS_CODES=84QW0000+; 85GP2200+

# Plus-code ranges: a box that SPANS two codes (the union of their cells), so
# the area is not limited to the fixed square grid a single code gives. Two full
# codes per entry separated by ":" or a space; semicolon-separated between
# entries. Order of the two codes does not matter.
# INAT_PLUS_CODE_RANGES=84QWJF00+:84QWQM00+; 84QV0000+ 84QX0000+

# ─── Fetch tuning (optional) ──────────────────────────────────────────────────
# INAT_QUALITY_GRADE=research
# INAT_PER_PAGE=200
# INAT_PARALLEL_FETCHES=1               # default 1 (serial). The shared session
#                                       # rate-limits as a group, so more workers
#                                       # only add per-IP throttle pressure.
# MAX_OBSERVATIONS_PER_SPECIES=0        # 0 = unlimited
# iNaturalist request rate for the shared session. Lower these if 429
# "normal_throttling" persists (common on a shared IP like Kaggle).
# INAT_PER_SECOND=1
# INAT_PER_MINUTE=60                    # try 30 if still throttled
# INAT_USER_AGENT=data-map-pipeline/1.0 (+https://github.com/skyfly200/data-map)

# ─── Earth Engine (the only credential the fast path needs) ───────────────────
# EARTHENGINE_PROJECT=your-gcloud-project-id

# ─── Raster fallback only (Earth Engine unavailable, or FETCH_RASTERS=1) ──────
# OPENTOPOGRAPHY_API_KEY=
# CDSAPI_URL=
# CDSAPI_KEY=

# ─── Pipeline behaviour (optional) ────────────────────────────────────────────
# REFRESH_ALL=0            # 1 = re-fetch and re-enrich everything
# SKIP_INAT_FETCH=0        # 1 = reuse cached observations, skip the fetch
# USE_EARTH_ENGINE=1       # 0 = raster fallback only
# FETCH_RASTERS=0          # 1 = download source rasters as well
# CLUSTER_COUNT=8

# Enrich one plus-code area at a time (each area finished + saved before the next,
# so an interrupted run keeps whole areas). AREA_BIN_PLUS_LENGTH sets area size by
# plus-code prefix length: 4 ≈ 1° (~110 km), 6 ≈ ~5.5 km, 2 ≈ 20°.
# ENRICH_BY_AREA=0
# AREA_BIN_PLUS_LENGTH=4

# Per-request Earth Engine deadline in ms (unstick a hung sample); 0 disables.
# EE_REQUEST_DEADLINE_MS=120000
