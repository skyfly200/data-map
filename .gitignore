# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files & credentials (never commit real keys)
.env
.env.*
!.env.example
.cdsapirc
!.cdsapirc.example

# data files
world_cover/
precip/
soil/
ndvi/
treecover/
dem/

# Per-species CSV store: raw observations (data/species/) are the tracked source
# of truth. Enriched files are regenerable pipeline output, and archive/ holds
# the migrated originals as a local backup — neither belongs in the repo.
data/enriched/
data/archive/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
coverage/
htmlcov/

# Enrichment checkpoint markers (resumable pipeline)
*.csv.done
*.csv.tmp
precip.zip

# Pre-compressed siblings of public assets, regenerated by the prebuild step.
public/**/*.geojson.gz
public/**/*.geojson.br

# Map chunks, derived from public/data/observations.geojson by
# scripts/mapChunks.mjs at build time (npm prebuild). 46 MB of files that are a
# pure function of a file already in the repo, so they are rebuilt rather than
# committed, and they cannot drift from the export they came from.
public/data/map/

# Editor files
.vscode/
*.swp
*.swo
*.tmp

