```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.nuxt/
.next/
public/dist/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
coverage/
htmlcov/

# Compiled and binary files
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a
*.lib
*.out

# OS generated files
.DS_Store
Thumbs.db

# Testing
*.test
*.tests
.test-result
test-results/

# Temporary files
*.tmp
*.temp
*.cache
*.bak
*.backup

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```